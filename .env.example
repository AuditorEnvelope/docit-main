# ============================================
# REQUIRED - lekhak ai Core
# ============================================

# GitHub Configuration
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_ORG=your_github_org_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# GitHub OAuth (for user authentication)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_random_jwt_secret_here

# Database (auto-created locally, or use hosted)
DATABASE_URL=postgresql://localhost/lekhak_ai

# ============================================
# LLM - Choose ONE (Gemini recommended!)
# ============================================

# Option 1: Gemini (Google) - RECOMMENDED
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Groq - Fast & Free alternative
# GROQ_API_KEY=your_groq_api_key_here

# Option 3: OpenAI - Optional (for embeddings)
# OPENAI_API_KEY=sk_your_openai_key_here

# ============================================
# OPTIONAL - Advanced Features
# ============================================

# Vector DB (for RAG - Day 3)
# Only needed if you want semantic search
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# Redis (for job queue)
# REDIS_URL=redis://localhost:6379

# Event Consumer Settings
# CONSUMER_BATCH_SIZE=10
# CONSUMER_POLL_INTERVAL=5

# ============================================
# LEGACY - Not Needed
# ============================================

# GitBook (old integration, not used)
# GITBOOK_API_KEY=your_gitbook_api_key
# GITBOOK_SITE_ID=your_site_id