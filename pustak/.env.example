# GitHub Configuration
# Get your personal access token from: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public repos only)
GITHUB_TOKEN=your_github_personal_access_token_here

# Your GitHub organization name (e.g., "AuditorEnvelope")
GITHUB_ORG=your_organization_name_here

# Optional: Backend API URL (if using DocAI backend)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional: GitHub API URL (if using DocAI backend)

